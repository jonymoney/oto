    "New audios you make get generated cover art in this style. Audios from people you follow keep their creator's style.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nuevos audios que crees tendrán portadas generadas con este estilo. Los audios de quienes sigues conservan el estilo de su creador."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你新创建的音频将使用此风格生成封面。你关注的人的音频保留其创作者的风格。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しく作るオーディオには、このスタイルのカバーアートが生成されます。フォロー中の人のオーディオは作者のスタイルのままです。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Audios von dir bekommen generierte Cover in diesem Stil. Audios von Leuten, denen du folgst, behalten den Stil ihres Erstellers."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes nouveaux audios reçoivent une pochette générée dans ce style. Les audios des personnes que tu suis gardent le style de leur créateur."
          }
        }
      }
    },
