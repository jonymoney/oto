    "Ask your AI chat to read articles, notes, or stories — oto turns them into audios that live here, ready to play anytime.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide a tu chat de IA que lea artículos, notas o historias — oto los convierte en audios que viven aquí, listos para reproducir cuando quieras."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让你的 AI 聊天朗读文章、笔记或故事 — oto 会把它们变成音频存放在这里，随时可以播放。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIチャットに記事やメモ、物語の読み上げを頼むと、otoがオーディオにしてここに保存。いつでも再生できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte deinen KI-Chat, Artikel, Notizen oder Geschichten vorzulesen — oto macht daraus Audios, die hier leben und jederzeit abspielbar sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande à ton IA de lire des articles, des notes ou des histoires — oto les transforme en audios qui vivent ici, prêts à écouter à tout moment."
          }
        }
      }
    },
