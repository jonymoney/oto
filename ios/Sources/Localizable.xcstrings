    "The audio stays in your library and can be downloaded again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio permanece en tu biblioteca y puedes descargarlo de nuevo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频仍会保留在你的资料库中，可以重新下载。"
