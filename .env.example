# oto — environment variables
# Copy to .env and fill in. In production these are set as Railway service
# variables (the ${{...}} examples are Railway reference-variable syntax).

# ── Server ────────────────────────────────────────────────────────────────
# Railway injects PORT at runtime; this is the local-dev default.
PORT=3001
# Canonical public URL of the MCP endpoint. Used as the `resource` value in
# OAuth Protected Resource Metadata and the WWW-Authenticate header.
# Production: https://<railway-domain>/mcp
MCP_SERVER_URL=http://localhost:3001/mcp
# 'oauth' (default) = full Better Auth OAuth 2.1 handshake; 'disabled' = local
# dev bypass with a fixed dev user. NEVER set 'disabled' in production.
AUTH_MODE=oauth
# Numeric App Store ID (from App Store Connect) — enables the Smart App Banner
# on share/profile pages. Leave unset until the iOS app ships.
APP_STORE_ID=
# Apple IAP (non-US paywall rail). Product id must match App Store Connect and
# StoreIAP.swift; the Apple ID number arrives with the ASC app record and is
# required for production-signed transaction verification (sandbox works without).
APPLE_PRODUCT_ID=audio.oto.app.unlimited.monthly
APPLE_APP_APPLE_ID=

# ── OpenAI (TTS generation) ───────────────────────────────────────────────
# https://platform.openai.com/api-keys — read automatically by the openai SDK.
OPENAI_API_KEY=sk-proj-...

# Generation defaults (gpt-4o-mini-tts: ~$0.015 per minute of audio)
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=coral
TTS_FORMAT=mp3

# ── TTS provider ──────────────────────────────────────────────────────────
# 'openai' (default) or 'fish' (Fish Audio). Flip to 'fish' to ear-test
# Spanish/English/mixed against gpt-4o-mini-tts (~$15 / 1M input bytes).
TTS_PROVIDER=openai
FISH_API_KEY=
FISH_MODEL=s2.1-pro
# Optional Fish voice/reference model id (a cloned or marketplace voice).
FISH_REFERENCE_ID=

# ── Better Auth (self-hosted authorization server) ────────────────────────
# Public origin of this service. Better Auth's baseURL + JWT issuer; the backend
# derives the JWKS URL (${BETTER_AUTH_URL}/api/auth/jwks) from it.
# Production: https://<railway-domain>
BETTER_AUTH_URL=http://localhost:3001
# Signing secret (>=32 chars). Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Comma-separated extra allowed origins (iOS app scheme, web-callback host).
# The BETTER_AUTH_URL and MCP_SERVER_URL origins are trusted automatically.
AUTH_TRUSTED_ORIGINS=

# Email (Resend) — magic links + email OTP. Optional in dev (senders log instead).
RESEND_API_KEY=
AUTH_EMAIL_FROM=oto <auth@oto.app>
# Web handoff page the magic-link email points at; it deep-links the single-use
# token to the iOS app (otoapp://auth-callback?token=...) so email previews can't
# burn it. Leave unset to email Better Auth's default verify URL.
AUTH_WEB_CALLBACK_URL=

# ── Database (Railway Postgres) — audio history metadata ──────────────────
# Railway: DATABASE_URL=${{Postgres.DATABASE_URL}} (private network).
# Local dev: use the DATABASE_PUBLIC_URL from the Railway Postgres service.
DATABASE_URL=postgresql://user:password@host:5432/railway

# ── Audio storage (Railway Storage Bucket, S3-compatible) ─────────────────
# Created via `railway bucket create <name> -r <region>`. Get values from
# `railway bucket credentials -b <name> --json`, or reference them in Railway:
# ${{<BucketName>.BUCKET}}, .ENDPOINT, .ACCESS_KEY_ID, .SECRET_ACCESS_KEY,
# .REGION. URLs are virtual-host style (https://<bucket>.<endpoint-host>).
BUCKET_NAME=my-bucket-xxxxxxxx
BUCKET_ENDPOINT=https://t3.storageapi.dev
BUCKET_REGION=auto
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
# Presigned GET URL lifetime (seconds)
AUDIO_URL_TTL_SECONDS=3600

# ── Generation quota ───────────────────────────────────────────────────────
# Per-user cap on cumulative generated audio minutes (replays are free,
# deletions never refund). 0 = unlimited for everyone.
QUOTA_MINUTES=10
# Comma-separated emails exempt from the quota (unlimited generation).
# Alternative without redeploy: set unlimited=true on the user's row in the
# usage_counters table.
QUOTA_EXEMPT_EMAILS=
# Where the "limit reached" upsell + the app's Upgrade button point.
UPGRADE_URL=https://oto.audio/upgrade

# ── Billing (Stripe) — the paid "unlimited" plan ──────────────────────────
# Billing routes return 501 until all three are set. Create a recurring Price
# in the Stripe dashboard and paste its id. Webhook secret is from the
# Stripe webhook endpoint you point at https://oto.audio/billing/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
