{
  "meta": {
    "name": "oto",
    "tagline": "Anything, read aloud.",
    "version": "1.0.0",
    "approved": "2026-08-21",
    "source": "docs/brand/decisions.md"
  },
  "color": {
    "ground":    { "light": "#F4F7EE", "dark": "#181A13", "name": "byakuroku", "kanji": "白緑", "role": "app background, lists, canvases" },
    "surface_1": { "light": "#FAFCF5", "dark": "#1F221A", "name": "gofun", "kanji": "胡粉", "role": "cards, player, bars" },
    "surface_2": { "light": "#FFFFFF", "dark": "#262A20", "name": "shironeri", "kanji": "白練", "role": "sheets, menus, dialogs" },
    "ink":       { "light": "#181A13", "dark": "#EEF1E5", "name": "shikkoku", "kanji": "漆黒", "role": "primary text, mastheads, rules" },
    "ink_muted": { "light": "#6D7561", "dark": "#99A189", "name": "rikyunezu", "kanji": "利休鼠", "role": "secondary text, timecodes" },
    "ink_faint": { "light": "#8F977F", "dark": "#6F7663", "name": null, "kanji": null, "role": "tertiary text, placeholders" },
    "hairline":  { "light": "#DDE3D1", "dark": "#2C3025", "name": null, "kanji": null, "role": "row separators, strokes" },
    "accent":    { "light": "#7BA428", "dark": "#AACF53", "name": "moegi", "kanji": "萌黄", "role": "on-air dot, NEW badges, focus, CTAs" },
    "accent_text": { "light": "#5C7D1E", "dark": "#AACF53", "name": "moegi", "kanji": "萌黄", "role": "accent at text sizes (eyebrows, links)" },
    "error":     { "light": "#C22645", "dark": "#FF7D92", "name": "kurenai", "kanji": "紅", "role": "errors, destructive actions" }
  },
  "voice": {
    "coral":   { "anchor": "#EB6101", "name": "shu",          "kanji": "朱" },
    "echo":    { "anchor": "#00A3AF", "name": "asagi",        "kanji": "浅葱" },
    "nova":    { "anchor": "#1E50A2", "name": "ruri",         "kanji": "瑠璃" },
    "sage":    { "anchor": "#7BA428", "name": "moegi",        "kanji": "萌黄", "note": "house voice — shares the accent hue by design" },
    "fable":   { "anchor": "#5654A2", "name": "kikyo",        "kanji": "桔梗" },
    "verse":   { "anchor": "#745399", "name": "edo_murasaki", "kanji": "江戸紫" },
    "ballad":  { "anchor": "#9E3D3F", "name": "suo",          "kanji": "蘇芳" },
    "ash":     { "anchor": "#BF783A", "name": "kohaku",       "kanji": "琥珀" },
    "alloy":   { "anchor": "#AFAFB0", "name": "ginnezu",      "kanji": "銀鼠" },
    "onyx":    { "anchor": "#595857", "name": "sumi",         "kanji": "墨" },
    "shimmer": { "anchor": "#3F8F7A", "name": "tamamushi",    "kanji": "玉虫", "iridescent": true, "note": "licensed gradient exception; anchor is the fallback solid" },
    "blaze":   { "anchor": "#D3381C", "name": "hi",           "kanji": "緋" },
    "adrian":  { "anchor": "#B7282E", "name": "akane",        "kanji": "茜" },
    "jasphina":{ "anchor": "#E95295", "name": "tsutsuji",     "kanji": "躑躅" },
    "sarah":   { "anchor": "#F0A0B4", "name": "sakura",       "kanji": "桜", "note": "vivified from near-white canonical" },
    "cedar":   { "anchor": "#007B43", "name": "tokiwa",       "kanji": "常磐" },
    "marin":   { "anchor": "#007BBB", "name": "konpeki",      "kanji": "紺碧" },
    "ethan":   { "anchor": "#004C71", "name": "ai",           "kanji": "藍" },
    "grim":    { "anchor": "#819C8B", "name": "seiji",        "kanji": "青磁" }
  },
  "reserved": {
    "yamabuki": { "hex": "#F8B500", "kanji": "山吹", "note": "retired accent — reserved, no voice takes it" },
    "wakakusa": { "hex": "#C3D825", "kanji": "若草", "note": "headroom for future voices" },
    "kincha":   { "hex": "#F39800", "kanji": "金茶", "note": "headroom for future voices" }
  },
  "type": {
    "display": { "family": "Clash Display", "weight": 600, "license": "Fontshare ITF-FFL", "roles": "wordmark, mastheads, player titles, editorial lines", "numerals": "never" },
    "ui_ios":  { "family": "SF Pro", "license": "Apple platforms only", "timecodes": "monospacedDigit()" },
    "ui_web":  { "family": "Instrument Sans", "license": "OFL", "timecodes": "font-variant-numeric: tabular-nums" },
    "jp":      { "family": "Zen Kaku Gothic New", "weight": 500, "license": "OFL", "roles": "音 seal, kanji micro-labels only", "min_px": 16 }
  },
  "rules": {
    "gradients": "tonal_only — a hue may ramp its own lightness; cross-hue only in voice orbs and shimmer",
    "timecodes": "ink_muted, tabular, UI face — never display type, never accent",
    "voice_color_pairing": "a voice color never travels alone — initial glyph or name rides along",
    "chime_octave": "A440 to A880",
    "kanji_usage": "real words doing a job; 音 only on about, share watermark, loading; never below 16px"
  }
}
